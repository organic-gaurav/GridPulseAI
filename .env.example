# GridPulse AI Environment Configuration
# Copy this file to .env for local development. Never commit .env files.

# Runtime mode: development or production
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
# Required when ENVIRONMENT=production. Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GRIDPULSE_API_TOKEN=

# Location for Open-Meteo Solar & Weather Forecast (Default: London / GB)
LATITUDE=51.5074
LONGITUDE=-0.1278

# Carbon Intensity Provider: "uk_carbon" (zero-config default) or "electricity_maps"
CARBON_PROVIDER=uk_carbon
ELECTRICITY_MAPS_API_KEY=
ELECTRICITY_MAPS_ZONE=GB

# Optional LLM API Keys (Zero-Key Deterministic Fallback activates automatically if unset)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Database & Simulation
DATABASE_URL=sqlite+aiosqlite:///./gridpulse.db
SIM_TICK_SECONDS=3.0
